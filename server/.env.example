

# --- Required -------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Models (check Google's current model list if a name stops working) ---
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.8-flash
EMBEDDING_DIMENSIONS=768

# --- RAG tuning -----------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
# Chunks scoring below this cosine similarity are discarded. If every chunk is
# discarded, the API answers "not in the document" without calling the LLM.
MIN_SIMILARITY=0.30

# --- Limits ---------------------------------------------------------------
MAX_DOCUMENT_BYTES=200000
MAX_QUESTION_CHARS=1000
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=200

# --- Server (used by `poetry run python -m app.main`) -----------------------
APP_HOST=127.0.0.1
APP_PORT=8000
# Auto-restart on code changes; set to false outside development.
APP_RELOAD=true

# --- Networking -----------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_BASE_DELAY_SECONDS=2
